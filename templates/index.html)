<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منصة الألعاب المتقدمة - Blue & Black Gaming</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #020617;
            --bg-card: #0f172a;
            --bg-accent: #1e293b;
            --blue-primary: #3b82f6;
            --blue-glow: #2563eb;
            --cyan-accent: #06b6d4;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --danger-red: #ef4444;
            --success-green: #10b981;
            --border-color: #1e293b;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Tajawal', sans-serif; }
        body { background-color: var(--bg-dark); color: var(--text-main); min-height: 100vh; padding-bottom: 40px; }

        .navbar {
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.95) 0%, rgba(2, 6, 23, 0.9) 100%);
            border-bottom: 1px solid rgba(59, 130, 246, 0.3);
            padding: 15px 20px;
            display: flex; justify-content: space-between; align-items: center;
            position: sticky; top: 0; z-index: 100; backdrop-filter: blur(10px);
        }

        .logo { font-size: 1.3rem; font-weight: 900; color: #fff; display: flex; align-items: center; gap: 10px; }
        .logo i { color: var(--blue-primary); }

        .balance-badge {
            background: rgba(59, 130, 246, 0.15);
            border: 1px solid var(--blue-primary);
            padding: 6px 14px; border-radius: 20px;
            color: var(--cyan-accent); font-weight: 700;
        }

        .admin-btn {
            background: var(--bg-accent); border: 1px solid var(--blue-primary);
            color: #fff; padding: 8px 14px; border-radius: 12px; cursor: pointer; font-weight: 600;
        }
        .admin-btn:hover { background: var(--blue-primary); }

        .container { max-width: 1100px; margin: 20px auto; padding: 0 15px; }

        .id-bar {
            background: var(--bg-card); border: 1px solid var(--border-color);
            border-radius: 16px; padding: 15px 20px; margin-bottom: 25px;
            display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 15px;
        }

        input[type="text"], input[type="number"] {
            background: #020617; border: 1px solid var(--border-color);
            color: #fff; padding: 8px 12px; border-radius: 8px; outline: none;
        }
        input:focus { border-color: var(--blue-primary); }

        .btn {
            background: var(--blue-primary); color: #fff; border: none;
            padding: 8px 16px; border-radius: 8px; cursor: pointer; font-weight: 700;
        }

        .games-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }

        .game-card {
            background: var(--bg-card); border: 1px solid var(--border-color);
            border-radius: 16px; overflow: hidden; transition: 0.3s;
        }
        .game-card:hover { transform: translateY(-5px); border-color: var(--blue-primary); }
        .game-thumb { width: 100%; height: 170px; object-fit: cover; }
        .game-body { padding: 15px; }

        .play-btn {
            background: linear-gradient(135deg, var(--blue-primary), var(--blue-glow));
            color: #fff; border: none; width: 100%; padding: 10px;
            border-radius: 10px; font-weight: 700; cursor: pointer; margin-top: 10px;
        }

        /* Modal Overlays */
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(2, 6, 23, 0.85); backdrop-filter: blur(8px);
            display: none; justify-content: center; align-items: center; z-index: 1000; padding: 15px;
        }
        .modal-card {
            background: var(--bg-card); border: 1px solid var(--blue-primary);
            border-radius: 20px; width: 100%; max-width: 650px; max-height: 90vh;
            overflow-y: auto; padding: 25px; position: relative;
        }
        .close-modal { position: absolute; top: 15px; left: 15px; background: none; border: none; color: #fff; font-size: 1.3rem; cursor: pointer; }

        /* Admin Controls */
        .algo-card { background: #020617; border: 1px solid var(--border-color); border-radius: 12px; padding: 15px; margin-bottom: 15px; }
        .slider-row { display: grid; grid-template-columns: 140px 1fr 60px; align-items: center; gap: 10px; font-size: 0.9rem; margin-bottom: 8px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 10px; border: 1px solid var(--border-color); text-align: right; }
        th { background: var(--bg-accent); color: var(--blue-primary); }
    </style>
</head>
<body>

    <header class="navbar">
        <div class="logo"><i class="fa-solid fa-gamepad"></i> منصة الألعاب الذكية</div>
        <div style="display:flex; gap:15px; align-items:center;">
            <div class="balance-badge"><i class="fa-solid fa-wallet"></i> <span id="nav-balance">0.00</span> $</div>
            <button class="admin-btn" onclick="openAdminModal()"><i class="fa-solid fa-user-shield"></i> لوحة الإدارة</button>
        </div>
    </header>

    <div class="container">
        <div class="id-bar">
            <div>
                <span style="color:var(--text-muted); font-size:0.85rem;">معرّف تلجرام الحالي:</span>
                <strong id="display-tg-id" style="color:var(--cyan-accent); font-size:1.1rem; margin-right:5px;">--</strong>
            </div>
            <div style="display:flex; gap:8px;">
                <input type="text" id="manual-tg-id" placeholder="أدخل Telegram ID">
                <button class="btn" onclick="changeTelegramId()">ربط الحساب</button>
            </div>
        </div>

        <h3 style="margin-bottom: 20px; border-right:4px solid var(--blue-primary); padding-right:10px;">
            الألعاب المتاحة (تضاف تلقائياً من ملفات games)
        </h3>
        <div class="games-grid" id="games-container"></div>
    </div>

    <!-- نافذة اللعب -->
    <div class="modal-overlay" id="game-modal">
        <div class="modal-card">
            <button class="close-modal" onclick="closeGameModal()">×</button>
            <h3 id="modal-game-title" style="color:var(--blue-primary); margin-bottom:10px;"></h3>
            <p id="game-modal-desc" style="color:var(--text-muted); font-size:0.9rem; margin-bottom:15px;"></p>
            <div style="text-align:center;">
                <input type="number" id="bet-amount" value="10" min="1" style="width:150px; text-align:center; font-size:1.1rem; font-weight:bold; margin-bottom:15px;">
                <button class="play-btn" id="play-action-btn" onclick="executePlay()">ابدأ اللعب الآن</button>
                <div id="result-box" style="margin-top:15px; padding:12px; border-radius:10px; display:none; font-weight:bold;"></div>
            </div>
        </div>
    </div>

    <!-- نافذة الإدارة والتحكم بالخوارزمية -->
    <div class="modal-overlay" id="admin-modal">
        <div class="modal-card" style="max-width:800px;">
            <button class="close-modal" onclick="closeAdminModal()">×</button>
            <h2 style="color:var(--blue-primary); margin-bottom:20px;"><i class="fa-solid fa-sliders"></i> لوحة تحكم المدير</h2>
            
            <div style="display:flex; gap:10px; margin-bottom:15px;">
                <button class="btn" onclick="showTab('algo-tab')">التحكم بالخوارزميات</button>
                <button class="btn" style="background:var(--bg-accent);" onclick="showTab('users-tab')">أرصدة المستخدمين</button>
            </div>

            <!-- تبويب التحكم بالخوارزمية -->
            <div id="algo-tab">
                <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:15px;">
                    يتم إدراج أي لعبة حديثة أو قديمة من مجلد <code>games</code> تلقائياً هنا لتتمكن من تعديل نسب الأرباح والخسارة فوراً.
                </p>
                <div id="algo-games-list"></div>
            </div>

            <!-- تبويب المستخدمين -->
            <div id="users-tab" style="display:none;">
                <table>
                    <thead>
                        <tr><th>Telegram ID</th><th>اسم المستخدم</th><th>الرصيد الحقيقي</th><th>تحديث الرصيد</th></tr>
                    </thead>
                    <tbody id="users-table-body"></tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        let currentTgId = "";
        let currentGameId = "";

        window.addEventListener('DOMContentLoaded', () => {
            if (window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.initDataUnsafe.user) {
                currentTgId = window.Telegram.WebApp.initDataUnsafe.user.id.toString();
            } else {
                currentTgId = localStorage.getItem("tg_user_id") || "123456789";
            }
            document.getElementById("manual-tg-id").value = currentTgId;
            fetchUserData();
            loadGamesList();
        });

        function changeTelegramId() {
            const val = document.getElementById("manual-tg-id").value.trim();
            if (val) {
                currentTgId = val;
                localStorage.setItem("tg_user_id", currentTgId);
                fetchUserData();
            }
        }

        function fetchUserData() {
            document.getElementById("display-tg-id").innerText = currentTgId;
            fetch(`/api/user/get?telegram_id=${currentTgId}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success) document.getElementById("nav-balance").innerText = data.balance.toFixed(2);
                });
        }

        function loadGamesList() {
            fetch('/api/games')
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        renderGames(data.games);
                        renderAdminAlgo(data.games);
                    }
                });
        }

        function renderGames(games) {
            const container = document.getElementById("games-container");
            container.innerHTML = "";
            games.forEach(g => {
                const card = document.createElement("div");
                card.className = "game-card";
                card.innerHTML = `
                    <img src="${g.image}" class="game-thumb">
                    <div class="game-body">
                        <h4>${g.name}</h4>
                        <p style="font-size:0.85rem; color:var(--text-muted);">${g.description}</p>
                        <button class="play-btn" onclick="openGameModal('${g.id}', '${g.name}', '${g.description}')">العب الآن</button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function openGameModal(id, name, desc) {
            currentGameId = id;
            document.getElementById("modal-game-title").innerText = name;
            document.getElementById("game-modal-desc").innerText = desc;
            document.getElementById("result-box").style.display = "none";
            document.getElementById("game-modal").style.display = "flex";
        }
        function closeGameModal() { document.getElementById("game-modal").style.display = "none"; }

        function executePlay() {
            const bet = parseFloat(document.getElementById("bet-amount").value);
            fetch('/api/play', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ telegram_id: currentTgId, game_id: currentGameId, bet_amount: bet })
            })
            .then(res => res.json())
            .then(data => {
                const resBox = document.getElementById("result-box");
                resBox.style.display = "block";
                if (data.success) {
                    document.getElementById("nav-balance").innerText = data.new_balance.toFixed(2);
                    if (data.multiplier > 0) {
                        resBox.style.background = "rgba(16, 185, 129, 0.2)";
                        resBox.style.color = "#10b981";
                        resBox.innerHTML = `${data.tier_label}<br>المضاعف: <strong>${data.multiplier}x</strong> | الربح: <strong>+$${data.win_amount.toFixed(2)}</strong>`;
                    } else {
                        resBox.style.background = "rgba(239, 68, 68, 0.2)";
                        resBox.style.color = "#ef4444";
                        resBox.innerHTML = `${data.tier_label}<br>خصم رهان: <strong>-$${data.bet_amount.toFixed(2)}</strong>`;
                    }
                } else {
                    alert(data.message);
                }
            });
        }

        function openAdminModal() { document.getElementById("admin-modal").style.display = "flex"; loadAdminUsers(); }
        function closeAdminModal() { document.getElementById("admin-modal").style.display = "none"; }
        function showTab(tab) {
            document.getElementById("algo-tab").style.display = tab === 'algo-tab' ? 'block' : 'none';
            document.getElementById("users-tab").style.display = tab === 'users-tab' ? 'block' : 'none';
        }

        function renderAdminAlgo(games) {
            const list = document.getElementById("algo-games-list");
            list.innerHTML = "";
            games.forEach(g => {
                const algo = g.algo;
                const card = document.createElement("div");
                card.className = "algo-card";
                card.innerHTML = `
                    <h4 style="color:var(--cyan-accent); margin-bottom:10px;">${g.name} (${g.id})</h4>
                    <div class="slider-row"><span>خسارة (ضربة خاسرة):</span><input type="range" min="0" max="100" value="${algo.loss_rate}" oninput="updateAlgoVal('${g.id}', 'loss', this.value)"><span id="val-${g.id}-loss">${algo.loss_rate}%</span></div>
                    <div class="slider-row"><span>ربح عادي (≤ 5x):</span><input type="range" min="0" max="100" value="${algo.normal_rate}" oninput="updateAlgoVal('${g.id}', 'normal', this.value)"><span id="val-${g.id}-normal">${algo.normal_rate}%</span></div>
                    <div class="slider-row"><span>ربح متوسط (≤ 10x):</span><input type="range" min="0" max="100" value="${algo.medium_rate}" oninput="updateAlgoVal('${g.id}', 'medium', this.value)"><span id="val-${g.id}-medium">${algo.medium_rate}%</span></div>
                    <div class="slider-row"><span>ربح عالي (≤ 50x):</span><input type="range" min="0" max="100" value="${algo.high_rate}" oninput="updateAlgoVal('${g.id}', 'high', this.value)"><span id="val-${g.id}-high">${algo.high_rate}%</span></div>
                    <div class="slider-row"><span>ربح ضخم (≤ 500x):</span><input type="range" min="0" max="100" value="${algo.mega_rate}" oninput="updateAlgoVal('${g.id}', 'mega', this.value)"><span id="val-${g.id}-mega">${algo.mega_rate}%</span></div>
                    <button class="btn" style="width:100%; margin-top:10px;" onclick="saveAlgo('${g.id}')">حفظ خوارزمية اللعبة فوراً</button>
                `;
                list.appendChild(card);
            });
        }

        function updateAlgoVal(id, type, val) { document.getElementById(`val-${id}-${type}`).innerText = val + "%"; }

        function saveAlgo(gameId) {
            const getVal = (t) => parseFloat(document.getElementById(`val-${gameId}-${t}`).innerText);
            fetch('/api/admin/algo/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    game_id: gameId,
                    loss_rate: getVal('loss'),
                    normal_rate: getVal('normal'),
                    medium_rate: getVal('medium'),
                    high_rate: getVal('high'),
                    mega_rate: getVal('mega')
                })
            })
            .then(res => res.json())
            .then(data => { alert(data.message); if (data.success) loadGamesList(); });
        }

        function loadAdminUsers() {
            fetch('/api/admin/users').then(r => r.json()).then(data => {
                const tbody = document.getElementById("users-table-body");
                tbody.innerHTML = "";
                data.users.forEach(u => {
                    tbody.innerHTML += `
                        <tr>
                            <td>${u.telegram_id}</td>
                            <td>${u.username}</td>
                            <td style="color:var(--cyan-accent); font-weight:bold;">$${u.balance.toFixed(2)}</td>
                            <td>
                                <input type="number" id="user-bal-${u.telegram_id}" value="${u.balance}" style="width:80px;">
                                <button class="btn" style="padding:4px 8px; font-size:0.8rem;" onclick="updateUserBalance('${u.telegram_id}')">تحديث</button>
                            </td>
                        </tr>
                    `;
                });
            });
        }

        function updateUserBalance(tgId) {
            const val = parseFloat(document.getElementById(`user-bal-${tgId}`).value);
            fetch('/api/admin/user/update-balance', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ telegram_id: tgId, balance: val })
            }).then(r => r.json()).then(d => { alert(d.message); fetchUserData(); loadAdminUsers(); });
        }
    </script>
</body>
</html>
